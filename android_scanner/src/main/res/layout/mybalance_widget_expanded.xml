<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/mb_widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/mb_widget_forest">
    <TextView android:id="@+id/mb_widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Мой баланс" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1"/>
    <TextView android:id="@+id/mb_widget_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="26sp" android:textStyle="bold" android:maxLines="1"/>
    <TextView android:id="@+id/mb_widget_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Данные скрыты" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
    <ProgressBar android:id="@+id/mb_widget_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="4dp" android:progressTint="#FFFFFF" android:progressBackgroundTint="#60FFFFFF" android:visibility="gone"/>
    <TextView android:id="@+id/mb_widget_macros" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="#FFFFFF" android:textSize="11sp" android:maxLines="2"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="6dp">
        <LinearLayout android:id="@+id/mb_widget_water_box" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:background="@drawable/mb_widget_action">
            <TextView android:id="@+id/mb_widget_water" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Вода" android:textColor="#FFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/mb_widget_water_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="12sp" android:maxLines="1"/>
        </LinearLayout>
        <LinearLayout android:id="@+id/mb_widget_steps_box" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:padding="4dp" android:layout_marginStart="6dp" android:background="@drawable/mb_widget_action">
            <TextView android:id="@+id/mb_widget_steps" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Шаги" android:textColor="#FFFFFF" android:textSize="12sp"/>
            <TextView android:id="@+id/mb_widget_steps_value" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="#FFFFFF" android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/mb_widget_food" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:minHeight="32dp" android:gravity="center" android:text="+ Еда" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:background="@drawable/mb_widget_action"/>
</LinearLayout>
